#!/bin/bash

# The image producer's source checks: no container, loop device, network or
# root. Needs Bash 5, Python 3.11+, GnuPG, jq and bsdtar (libarchive).

set -euo pipefail

if (( BASH_VERSINFO[0] < 5 )); then
  echo "image-builder/test/all requires Bash 5 or newer" >&2
  exit 1
fi

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"
tests_temp=$(mktemp -d "${TMPDIR:-/tmp}/omarchy-image-builder-tests.XXXXXX")
trap 'rm -rf -- "$tests_temp"' EXIT
export TMPDIR=$tests_temp
export PYTHONPYCACHEPREFIX=$tests_temp/pycache

for script in bin/build-mac-image bin/mac-image-inputs builder/finalize-root test/all test/*.sh; do
  bash -n "$script"
done
for script in bin/mac-image-check builder/*.py test/*.py; do
  python3 -m py_compile "$script"
done
echo "ok - shell syntax and Python compilation"

python3 test/test_candidate_set.py
python3 test/test_inspection.py
python3 test/test_mac_image_check.py
python3 test/test_lab_access.py
for test_file in test/*-test.sh; do
  "$BASH" "$test_file"
done

echo "Image producer source checks passed; building an image needs an aarch64 Linux host with Docker."
