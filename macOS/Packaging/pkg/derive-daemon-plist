#!/bin/bash
# Derive the system LaunchDaemon plist that the packages install into
# /Library/LaunchDaemons from the plist the app embeds under
# Contents/Library/LaunchDaemons. The embedded copy uses BundleProgram (a path
# relative to the bundle, the SMAppService form); a daemon in
# /Library/LaunchDaemons needs an absolute Program path, or launchd cannot load
# it and the app reports the privileged helper as unreachable.
#
# The daemon runs as root, so its Program is the helper's copy in
# /Library/PrivilegedHelperTools (root-owned, where SMJobBless and the private
# test package put it), never the copy inside the app in /Applications.
#
# Usage: derive-daemon-plist <app bundle> <output plist> [helper output]
#   helper output: where to copy the app's helper (mode 0755), normally the
#   payload's Library/PrivilegedHelperTools/<helper identifier>.
set -euo pipefail

app=${1:-}
output=${2:-}
helper_output=${3:-}
[[ -d $app && -n $output ]] || {
  echo "usage: derive-daemon-plist <app bundle> <output plist> [helper output]" >&2
  exit 64
}

# shellcheck source=../identity.conf
source "$(cd "$(dirname "$0")/.." && pwd)/identity.conf"
embedded="$app/Contents/Library/LaunchDaemons/$INSTALLER_HELPER_IDENTIFIER.plist"
[[ -f $embedded ]] || {
  echo "derive-daemon-plist: embedded daemon plist is missing: $embedded" >&2
  exit 66
}

python3 - "$embedded" "$output" "$app" "/Library/PrivilegedHelperTools/$INSTALLER_HELPER_IDENTIFIER" "$helper_output" <<'PY'
import plistlib, sys, os, shutil
embedded, output, app, program, helper_output = sys.argv[1:6]
with open(embedded, "rb") as handle:
    plist = plistlib.load(handle)
relative = plist.pop("BundleProgram", None)
if not relative:
    sys.exit("derive-daemon-plist: embedded plist lacks a bundle-relative BundleProgram")
if os.path.isabs(relative) or ".." in relative.split("/"):
    sys.exit("derive-daemon-plist: BundleProgram must be a bundle-relative path: %s" % relative)
helper = os.path.join(app, relative)
if os.path.islink(helper) or not os.path.isfile(helper):
    sys.exit("derive-daemon-plist: helper is missing inside the app: %s" % relative)
plist["Program"] = program
for key in ("Label", "MachServices", "UserName"):
    if key not in plist:
        sys.exit("derive-daemon-plist: embedded plist lacks %s" % key)
with open(output, "wb") as handle:
    plistlib.dump(plist, handle, sort_keys=True)
if helper_output:
    shutil.copyfile(helper, helper_output)
    os.chmod(helper_output, 0o755)
print(program)
PY
