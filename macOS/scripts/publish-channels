#!/bin/bash
# Publish and promote the installer's release channels on Cloudflare R2.
#
# Everything this tool touches lives under the release stream's path
# (INSTALLER_STREAM_PATH); keys below are relative to it. The MX Mac feeds at
# the root of the bucket are never read, written or pruned here.
#
# Two kinds of object live in the stream. Everything under releases/ and
# installer/<version>/ is immutable and never overwritten. Exactly four keys
# per channel are rewritten in place, and only through this tool:
#
#   channels/<channel>/catalog.signed.json
#   channels/<channel>/channel.json
#   installer/<channel>/<INSTALLER_FILE_STEM>.zip
#   installer/<channel>/installer.json
#
# The catalog and its signature travel as one envelope so a channel update is a
# single atomic write: a reader can never see a new catalog beside the old
# signature.
set -euo pipefail

script_directory=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=/dev/null
. "$script_directory/publish-m1-release"
# shellcheck source=../Packaging/identity.conf
. "$script_directory/../Packaging/identity.conf"

R2_BUCKET="${OMARCHY_R2_BUCKET:-$INSTALLER_R2_BUCKET}"
R2_ENDPOINT="${OMARCHY_R2_ENDPOINT:-$INSTALLER_R2_ENDPOINT}"
PUBLIC_BASE="${OMARCHY_PUBLIC_BASE:-$INSTALLER_PUBLIC_BASE}"
STREAM_PATH="${OMARCHY_STREAM_PATH:-$INSTALLER_STREAM_PATH}"
[[ $STREAM_PATH =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "the stream path must be one lowercase path segment: $STREAM_PATH"
STREAM_BASE="$PUBLIC_BASE/$STREAM_PATH"
CHANNELS="stable rc edge"
TRUST_ROOT="${OMARCHY_TRUST_ROOT:-$script_directory/../Release/trust-root.ed25519.pub}"
SIGNING_TOOL="${OMARCHY_CATALOG_SIGNING_TOOL:-xcrun swift $script_directory/catalog-signing.swift}"
# The download is the notarized app in a zip; the installer package is no
# longer published.
ZIP_FILE_NAME="$INSTALLER_FILE_STEM.zip"
# installer.json from the package era records no build number; the last
# package release, 2.0.10, was build 27, so nothing at or below it publishes.
LEGACY_BUILD_FLOOR=27
ZIP_DOWNLOAD_NAME="$INSTALLER_APP_NAME.zip"
NO_CACHE="no-cache, max-age=0, must-revalidate"

scratch_root=""
cleanup_scratch() {
  [[ -z $scratch_root ]] || rm -rf "$scratch_root"
}
trap cleanup_scratch EXIT

make_scratch() {
  scratch_root=$(mktemp -d)
  printf '%s\n' "$scratch_root"
}

channels_usage() {
  cat <<'USAGE'
Usage:
  publish-channels envelope --catalog FILE --signature FILE --output FILE
  publish-channels empty-catalog --output FILE [--sequence N]
  publish-channels os-promote --tag TAG --to stable|rc|edge [--minimum-sequence N] [--no-prune]
  publish-channels app-publish --zip FILE --version X.Y.Z [--to stable|rc|edge]
  publish-channels channel-status [--channel stable|rc|edge|all]
  publish-channels prune [--confirm]

Keys are relative to the release stream, PUBLIC_BASE/STREAM_PATH. empty-catalog
writes the unsigned catalog of a channel with no Mac release yet: sign it,
wrap it with envelope, stage it as releases/TAG/catalog.signed.json and
os-promote it like any other release. Its sequence defaults to the current Unix
time, as real catalogs use; a later one would block every real release until
that time passes, so it is refused.

Credentials come from AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY or the Keychain
items omarchy-r2-access-key-id and omarchy-r2-secret-access-key.
USAGE
  exit 64
}

validate_os_tag() {
  # A trailing -<lane> names a parallel payload lane built from the same
  # release train.
  [[ $1 =~ ^os-v[0-9]+\.[0-9]+\.[0-9]+-mac\.[0-9]+\.[0-9]{8}(\.[0-9]+)?(-[a-z][a-z0-9]*)?$ ]] ||
    die "invalid OS release tag: $1 (expected os-vX.Y.Z-mac.N.YYYYMMDD[-lane])"
}

validate_channel() {
  [[ " $CHANNELS " == *" $1 "* ]] || die "invalid channel: $1"
}

validate_installer_version() {
  [[ $1 =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "invalid installer version: $1"
}

mutable_key_allowed() {
  local channel
  for channel in $CHANNELS; do
    case $1 in
      "channels/$channel/catalog.signed.json" | "channels/$channel/channel.json") return 0 ;;
      "installer/$channel/$ZIP_FILE_NAME" | "installer/$channel/installer.json") return 0 ;;
    esac
  done
  return 1
}

# The bucket key of a stream-relative key.
bucket_key() {
  printf '%s/%s\n' "$STREAM_PATH" "$1"
}

# A channel with no Mac release yet still serves a signed catalog, so the app
# can tell "nothing here yet" from a channel it cannot reach or verify.
write_empty_catalog() {
  local sequence=$1 output=$2 now
  now=$(date +%s)
  [[ -n $sequence ]] || sequence=$now
  [[ $sequence =~ ^[1-9][0-9]*$ ]] || die "the sequence must be a positive integer: $sequence"
  (( sequence <= now )) ||
    die "the sequence $sequence is later than now ($now); real catalogs could not follow it"
  [[ ! -e $output ]] || die "refusing to overwrite $output"
  python3 - "$sequence" "$output" <<'PY'
import datetime
import json
import sys

sequence, output = int(sys.argv[1]), sys.argv[2]
catalog = {
    "schemaVersion": 4,
    "sequence": sequence,
    "issuedAt": datetime.datetime.now(datetime.timezone.utc)
    .replace(microsecond=0)
    .strftime("%Y-%m-%dT%H:%M:%SZ"),
    "models": [],
}
with open(output, "x", encoding="utf-8") as stream:
    json.dump(catalog, stream, indent=2)
    stream.write("\n")
PY
  echo "empty_catalog=$output"
  echo "catalog_sequence=$sequence"
}

build_envelope() {
  local catalog=$1 signature=$2 output=$3
  require_file "$catalog"
  require_file "$signature"
  # A catalog offering any Mac enables every M1, M2 and M3 Mac
  # (scripts/supported-models.json); only an empty catalog lists none.
  python3 "$script_directory/supported_models.py" check-catalog "$catalog" ||
    die "$catalog does not enable every supported Mac"
  (( $(file_size "$signature") == 64 )) || die "a catalog signature must be 64 bytes"
  python3 - "$catalog" "$signature" "$output" <<'PY'
import base64
import json
import sys

catalog, signature, output = sys.argv[1:4]
document = {
    "schema_version": 1,
    "catalog": base64.b64encode(open(catalog, "rb").read()).decode("ascii"),
    "signature": base64.b64encode(open(signature, "rb").read()).decode("ascii"),
}
with open(output, "w", encoding="utf-8") as stream:
    json.dump(document, stream, sort_keys=True, separators=(",", ":"))
PY
}

decode_envelope() {
  local envelope=$1 catalog=$2 signature=$3
  require_file "$envelope"
  python3 - "$envelope" "$catalog" "$signature" <<'PY'
import base64
import json
import sys

envelope, catalog, signature = sys.argv[1:4]
document = json.load(open(envelope, encoding="utf-8"))
if set(document) != {"schema_version", "catalog", "signature"}:
    raise SystemExit("envelope has unexpected keys")
if document["schema_version"] != 1:
    raise SystemExit("unsupported envelope schema")
open(catalog, "wb").write(base64.b64decode(document["catalog"], validate=True))
open(signature, "wb").write(base64.b64decode(document["signature"], validate=True))
PY
}

verify_catalog() {
  local catalog=$1 signature=$2 result
  require_file "$TRUST_ROOT"
  result=$($SIGNING_TOOL verify "$TRUST_ROOT" "$catalog" "$signature" 2>/dev/null) ||
    die "catalog signature does not verify against $TRUST_ROOT"
  [[ $result == "catalog_signature=passed" ]] ||
    die "unexpected verification result: $result"
}

catalog_field() {
  python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))[sys.argv[2]])' "$1" "$2"
}

# Every artifact a catalog names must already sit under the immutable prefix of
# the tag being promoted, at exactly the size the catalog claims.
assert_catalog_artifacts_published() {
  local catalog=$1 tag=$2 expected_prefix="$STREAM_BASE/releases/$tag/"
  local url size actual
  while read -r url size; do
    [[ $url == "$expected_prefix"* ]] ||
      die "catalog names an artifact outside releases/$tag: $url"
    actual=$(curl -fsSLI -H 'Cache-Control: no-cache' "$url" 2>/dev/null |
      awk 'BEGIN{IGNORECASE=1} /^content-length:/ {gsub(/\r/,"",$2); print $2}' | tail -1) ||
      die "artifact is not published: $url"
    [[ -n $actual ]] || die "artifact is not published: $url"
    (( actual == size )) ||
      die "$url is $actual bytes but the catalog claims $size"
    echo "  verified $url"
  done < <(python3 - "$catalog" <<'PY'
import json
import sys

catalog = json.load(open(sys.argv[1]))
seen = set()
for model in catalog["models"]:
    for role in ("engineArtifact", "metadataArtifact", "payloadArtifact"):
        artifact = model.get(role)
        if not artifact:
            continue
        for record in [artifact, *artifact.get("parts", [])]:
            key = (record["sourceURL"], record["sizeBytes"])
            if key in seen:
                continue
            seen.add(key)
            print(record["sourceURL"], record["sizeBytes"])
PY
  )
}

# Prints 200 only for a complete transfer and 404 for nothing there; anything
# else, including a 200 whose body was cut short or reset, is printed as the
# failure it was, so callers can't mistake it for either.
fetch_status() {
  local path=$1 output=$2 status rc=0
  status=$(curl -sSL -H 'Cache-Control: no-cache' -o "$output" \
    -w '%{http_code}' "$STREAM_BASE/$path" 2>/dev/null) || rc=$?
  if [[ $status == 404 ]]; then
    echo 404
  elif (( rc == 0 )) && [[ $status == 200 ]]; then
    echo 200
  else
    echo "HTTP ${status:-none}, curl exit $rc"
  fi
}

fetch_public() {
  local path=$1 output=$2 status
  status=$(curl -fsSL -H 'Cache-Control: no-cache' -o "$output" \
    -w '%{http_code}' "$STREAM_BASE/$path" 2>/dev/null) || status=""
  [[ $status == "200" ]] || return 1
  return 0
}

put_object() {
  local source=$1 key=$2
  shift 2
  aws s3 cp "$source" "s3://$R2_BUCKET/$(bucket_key "$key")" \
    --endpoint-url "$R2_ENDPOINT" --region auto --only-show-errors "$@"
}

put_mutable() {
  local source=$1 key=$2 content_type=$3
  shift 3
  mutable_key_allowed "$key" || die "refusing to overwrite a key that must stay immutable: $key"
  put_object "$source" "$key" --cache-control "$NO_CACHE" \
    --content-type "$content_type" "$@"
  echo "  wrote $key"
}

put_immutable() {
  local source=$1 key=$2 remote local_size
  shift 2
  local_size=$(file_size "$source")
  remote=$(aws s3api head-object --bucket "$R2_BUCKET" --key "$(bucket_key "$key")" \
    --endpoint-url "$R2_ENDPOINT" --region auto \
    --query ContentLength --output text 2>/dev/null) || remote=""
  if [[ -z $remote ]]; then
    put_object "$source" "$key" "$@"
    echo "  uploaded $key"
  elif (( remote == local_size )); then
    echo "  matched $key ($remote bytes)"
  else
    die "published $key is $remote bytes but staged bytes are $local_size; publish a new version"
  fi
}

verify_back() {
  local path=$1 expected=$2 actual scratch
  scratch=$(mktemp)
  fetch_public "$path" "$scratch" || {
    rm -f "$scratch"
    die "could not read back $STREAM_BASE/$path"
  }
  actual=$(file_digest "$scratch")
  rm -f "$scratch"
  [[ $actual == "$expected" ]] ||
    die "$STREAM_BASE/$path serves $actual, expected $expected"
  echo "  verified $STREAM_BASE/$path"
}

os_promote() {
  local tag="" channel="" minimum_sequence=0 prune_after=1
  while (( $# > 0 )); do
    case $1 in
      --tag) tag=${2:-}; shift 2 ;;
      --to) channel=${2:-}; shift 2 ;;
      --minimum-sequence) minimum_sequence=${2:-}; shift 2 ;;
      --no-prune) prune_after=0; shift ;;
      *) channels_usage ;;
    esac
  done
  [[ -n $tag && -n $channel ]] || channels_usage
  validate_os_tag "$tag"
  validate_channel "$channel"
  command -v aws >/dev/null || die "missing command: aws"

  local work
  work=$(make_scratch)

  echo "Reading releases/$tag/catalog.signed.json"
  fetch_public "releases/$tag/catalog.signed.json" "$work/candidate.json" ||
    die "releases/$tag/catalog.signed.json is not published"
  decode_envelope "$work/candidate.json" "$work/catalog" "$work/signature"
  verify_catalog "$work/catalog" "$work/signature"

  local sequence
  sequence=$(catalog_field "$work/catalog" sequence)
  [[ $sequence =~ ^[0-9]+$ ]] || die "catalog sequence is not a number"
  (( sequence > minimum_sequence )) ||
    die "catalog sequence $sequence is not above the required floor $minimum_sequence"

  echo "Checking every artifact the catalog names"
  assert_catalog_artifacts_published "$work/catalog" "$tag"

  local live_sequence=0 previous_tag=""
  if fetch_public "channels/$channel/catalog.signed.json" "$work/live.json"; then
    if [[ $(file_digest "$work/candidate.json") == "$(file_digest "$work/live.json")" ]]; then
      echo "channels/$channel already serves these exact bytes"
      return 0
    fi
    decode_envelope "$work/live.json" "$work/live-catalog" "$work/live-signature"
    verify_catalog "$work/live-catalog" "$work/live-signature"
    live_sequence=$(catalog_field "$work/live-catalog" sequence)
    (( sequence > live_sequence )) ||
      die "candidate sequence $sequence does not exceed the live $channel sequence $live_sequence"
    # The live pointer names the set it serves, even an empty catalog's that
    # names no artifact; the catalog's own artifacts are the fallback.
    if fetch_public "channels/$channel/channel.json" "$work/live-channel.json"; then
      previous_tag=$(python3 -c '
import json, sys
print(json.load(open(sys.argv[1])).get("os_tag") or "")
' "$work/live-channel.json")
    fi
    [[ -n $previous_tag ]] || previous_tag=$(python3 -c '
import json, re, sys
for model in json.load(open(sys.argv[1]))["models"]:
    m = re.search(r"/releases/([^/]+)/", model["payloadArtifact"]["sourceURL"])
    if m:
        print(m.group(1)); break
' "$work/live-catalog")
  else
    echo "channels/$channel is empty; this is its first catalog"
  fi

  r2_credentials
  confirm_publication "$tag" "r2:$R2_BUCKET/$(bucket_key "channels/$channel")" "catalog.signed.json channel.json"

  python3 - "$work/channel.json" "$channel" "$tag" "$sequence" \
    "$(file_digest "$work/catalog")" "$previous_tag" <<'PY'
import datetime
import json
import sys

output, channel, tag, sequence, catalog_sha256, previous_tag = sys.argv[1:7]
document = {
    "schema_version": 1,
    "channel": channel,
    "os_tag": tag,
    "sequence": int(sequence),
    "catalog_sha256": catalog_sha256,
    # The set this promotion superseded stays published as rollback material.
    "previous_os_tag": previous_tag or None,
    "promoted_at": datetime.datetime.now(datetime.timezone.utc)
    .replace(microsecond=0)
    .strftime("%Y-%m-%dT%H:%M:%SZ"),
}
with open(output, "w", encoding="utf-8") as stream:
    json.dump(document, stream, indent=2)
    stream.write("\n")
PY

  # One atomic write flips the channel; the pointer file is descriptive only.
  put_mutable "$work/candidate.json" "channels/$channel/catalog.signed.json" application/json
  put_mutable "$work/channel.json" "channels/$channel/channel.json" application/json
  verify_back "channels/$channel/catalog.signed.json" "$(file_digest "$work/candidate.json")"
  verify_back "channels/$channel/channel.json" "$(file_digest "$work/channel.json")"

  echo "channel_sequence=$sequence"
  echo "channel_os_tag=$tag"
  echo "channel_previous_sequence=$live_sequence"

  # A new stable release is the moment the ones before it stop mattering, so
  # reclaim them here rather than as a chore someone has to remember. A bucket
  # lock that still protects them is reported, not treated as a failed release.
  if (( prune_after )) && [[ $channel == "stable" ]]; then
    echo
    echo "Pruning release sets nothing references any more"
    if ! OMARCHY_PUBLISH_ASSUME_YES=prune prune --confirm; then
      echo "  (pruning was refused; the promotion itself succeeded)" >&2
    fi
  fi
}

app_publish() {
  local zip="" version="" channel="stable"
  while (( $# > 0 )); do
    case $1 in
      --zip) zip=${2:-}; shift 2 ;;
      --pkg) die "the installer package is no longer published; publish the app zip with --zip (Packaging/make-download-zip.sh)" ;;
      --version) version=${2:-}; shift 2 ;;
      --to) channel=${2:-}; shift 2 ;;
      *) channels_usage ;;
    esac
  done
  [[ -n $zip && -n $version ]] || channels_usage
  require_file "$zip"
  [[ $zip == *.zip ]] || die "the download must be a .zip: $zip"
  validate_installer_version "$version"
  validate_channel "$channel"
  command -v aws >/dev/null || die "missing command: aws"

  local work digest immutable_key entries
  work=$(make_scratch)

  # The zip must hold exactly the app, and the app must be signed and carry a
  # stapled notarization ticket, or it would fail on the far side of a
  # download; otherwise nothing reaches the bucket.
  entries=$(python3 -c '
import sys, zipfile
print("\n".join(sorted({name.split("/")[0] for name in zipfile.ZipFile(sys.argv[1]).namelist()})))
' "$zip" 2>/dev/null) || die "not a readable zip: $zip"
  [[ $entries == "$INSTALLER_APP_NAME.app" ]] ||
    die "the zip must contain only $INSTALLER_APP_NAME.app: $zip"
  ditto -x -k "$zip" "$work/unpacked" || die "the zip could not be unpacked: $zip"
  codesign --verify --deep --strict "$work/unpacked/$INSTALLER_APP_NAME.app" >/dev/null 2>&1 ||
    die "the app in the zip is not validly signed: $zip"
  xcrun stapler validate "$work/unpacked/$INSTALLER_APP_NAME.app" >/dev/null 2>&1 ||
    die "the app in the zip has no stapled notarization ticket: $zip"

  # It must also be this team's app, the version being published, a newer
  # build than the channel already serves, and able to install its own helper.
  local app="$work/unpacked/$INSTALLER_APP_NAME.app" team_requirement build previous
  team_requirement="anchor apple generic and identifier \"$INSTALLER_APP_IDENTIFIER\" and certificate leaf[subject.OU] = \"$INSTALLER_TEAM_ID\""
  codesign --verify --strict -R="$team_requirement" "$app" >/dev/null 2>&1 ||
    die "the app in the zip is not signed by team $INSTALLER_TEAM_ID: $zip"
  local helper_requirement
  helper_requirement="anchor apple generic and identifier \"$INSTALLER_HELPER_IDENTIFIER\" and certificate leaf[subject.OU] = \"$INSTALLER_TEAM_ID\""
  codesign --verify --strict -R="$helper_requirement" \
    "$app/Contents/Library/LaunchServices/$INSTALLER_HELPER_IDENTIFIER" >/dev/null 2>&1 ||
    die "the app's helper is not signed as this team's helper: $zip"
  build=$(python3 - "$app" "$version" "$INSTALLER_HELPER_IDENTIFIER" "$team_requirement" \
    "$helper_requirement" 2>"$work/app-check.err" <<'PY'
import os
import plistlib
import re
import sys

app, version, helper, app_requirement, helper_requirement = sys.argv[1:6]
with open(os.path.join(app, "Contents/Info.plist"), "rb") as stream:
    info = plistlib.load(stream)
shipped = info.get("CFBundleShortVersionString")
if shipped != version:
    sys.exit(f"the app is version {shipped}, not {version}")
build = str(info.get("CFBundleVersion", ""))
if not build.isdigit():
    sys.exit("the app has no numeric build number")
declared = (info.get("SMPrivilegedExecutables") or {}).get(helper)
if not declared:
    sys.exit("the app does not declare its helper for SMJobBless, so it cannot install it")
if declared != helper_requirement:
    sys.exit("the app declares its helper with another signing requirement")
path = os.path.join(app, "Contents/Library/LaunchServices", helper)
if os.path.islink(path) or not os.path.isfile(path) or not os.access(path, os.X_OK):
    sys.exit("the app has no helper where SMJobBless looks for it")
with open(path, "rb") as stream:
    binary = stream.read()
# The helper's Info.plist and launchd job are XML property lists linked into
# its __TEXT sections; read them straight from the bytes.
embedded = []
for block in re.findall(rb"<\?xml.*?</plist>", binary, re.S):
    try:
        embedded.append(plistlib.loads(block))
    except Exception:
        pass
helper_info = next((d for d in embedded if d.get("CFBundleIdentifier") == helper), None)
job = next((d for d in embedded if d.get("Label") == helper), None)
if helper_info is None or job is None:
    sys.exit("the app's helper carries no Info.plist and launchd job for SMJobBless")
if str(helper_info.get("CFBundleVersion")) != build:
    sys.exit(f"the app's helper is build {helper_info.get('CFBundleVersion')}, not {build}")
if app_requirement not in (helper_info.get("SMAuthorizedClients") or []):
    sys.exit("the app's helper does not authorize this app")
if not (job.get("MachServices") or {}).get(helper):
    sys.exit("the app's helper job does not publish its service")
client = (job.get("EnvironmentVariables") or {}).get("OMARCHY_CLIENT_CODE_SIGNING_REQUIREMENT")
if client != app_requirement:
    sys.exit("the app's helper job does not require this app as its client")
print(int(build))
PY
  ) || die "$(cat "$work/app-check.err"): $zip"

  digest=$(file_digest "$zip")
  # What the channel serves now, metadata and zip each on its own: the zip goes
  # up first, so an interrupted publish can leave either without the other.
  # Only a 404 means nothing is there; any other failure stops the publish.
  local status zip_status served=""
  status=$(fetch_status "installer/$channel/installer.json" "$work/previous.json")
  case $status in
    200) ;;
    404) rm -f "$work/previous.json" ;;
    *) die "could not read $channel's current installer.json ($status); the build check can't be skipped" ;;
  esac
  zip_status=$(fetch_status "installer/$channel/$ZIP_FILE_NAME" "$work/previous.zip")
  case $zip_status in
    200) served=$(file_digest "$work/previous.zip") ;;
    404) ;;
    *) die "could not read $channel's current zip ($zip_status); the build check can't be skipped" ;;
  esac
  if [[ $status == 200 || -n $served ]]; then
    previous=$(python3 - "$work/previous.json" "$digest" "$served" "$work/previous.zip" \
      "$INSTALLER_APP_NAME.app" "$LEGACY_BUILD_FLOOR" 2>"$work/previous.err" <<'PY'
import json
import os
import plistlib
import sys
import zipfile

document_path, digest, served, zip_path, app, floor = sys.argv[1:7]
document = json.load(open(document_path)) if os.path.exists(document_path) else None
recorded = None
if document is not None:
    # installer.json from before build numbers were recorded has none; the
    # last such release was the 2.0.10 package, build 27, so that is the floor.
    recorded = document.get("build_number", floor)
    if isinstance(recorded, bool) or not str(recorded).isdigit():
        sys.exit(f"the channel's installer.json has a malformed build_number: {recorded!r}")
    recorded = int(recorded)
    # The very same zip may be republished, as after a failed upload, but only
    # if the channel does not already serve some other zip.
    if document.get("sha256") == digest and served in ("", digest):
        print("same")
        sys.exit(0)
if served == digest:
    # This zip is already served, left by an interrupted run of this publish;
    # it still has to beat whatever the metadata records.
    print("same" if recorded is None else recorded)
    sys.exit(0)
builds = [] if recorded is None else [recorded]
# The zip actually served counts too, so no build slips beneath it, whether
# the metadata beside it is older or missing.
if served:
    try:
        with zipfile.ZipFile(zip_path) as archive:
            info = plistlib.loads(archive.read(f"{app}/Contents/Info.plist"))
        builds.append(int(str(info["CFBundleVersion"])))
    except Exception as error:
        sys.exit(f"the channel's current zip has no readable build number: {error}")
print(max(builds))
PY
    ) || die "$(cat "$work/previous.err")"
    [[ $previous == "same" ]] || (( 10#$build > 10#$previous )) ||
      die "build $build is not above build $previous already published to $channel"
  fi
  printf '%s  %s\n' "$digest" "$INSTALLER_FILE_STEM-$version.zip" >"$work/zip.sha256"
  immutable_key="installer/$version/$INSTALLER_FILE_STEM-$version.zip"

  python3 - "$work/installer.json" "$version" "$digest" "$(file_size "$zip")" \
    "$STREAM_BASE/$immutable_key" "$build" <<'PY'
import datetime
import json
import sys

output, version, sha256, size_bytes, source, build = sys.argv[1:7]
document = {
    "schema_version": 1,
    "version": version,
    "build_number": int(build),
    "sha256": sha256,
    "size_bytes": int(size_bytes),
    "published_at": datetime.datetime.now(datetime.timezone.utc)
    .replace(microsecond=0)
    .strftime("%Y-%m-%dT%H:%M:%SZ"),
    "source": source,
}
with open(output, "w", encoding="utf-8") as stream:
    json.dump(document, stream, indent=2)
    stream.write("\n")
PY

  r2_credentials
  confirm_publication "installer-v$version" "r2:$R2_BUCKET/$(bucket_key "installer/$channel")" \
    "$ZIP_FILE_NAME installer.json"

  put_immutable "$zip" "$immutable_key" --content-type application/zip
  put_immutable "$work/zip.sha256" "$immutable_key.sha256" --content-type text/plain
  put_mutable "$zip" "installer/$channel/$ZIP_FILE_NAME" application/zip \
    --content-disposition "attachment; filename=\"$ZIP_DOWNLOAD_NAME\""
  put_mutable "$work/installer.json" "installer/$channel/installer.json" application/json
  verify_back "installer/$channel/$ZIP_FILE_NAME" "$digest"
  verify_back "installer/$channel/installer.json" "$(file_digest "$work/installer.json")"

  echo "installer_version=$version"
  echo "installer_sha256=$digest"
}

channel_status() {
  local requested="all"
  while (( $# > 0 )); do
    case $1 in
      --channel) requested=${2:-}; shift 2 ;;
      *) channels_usage ;;
    esac
  done
  [[ $requested == "all" ]] || validate_channel "$requested"

  local work channels channel failures=0
  work=$(make_scratch)
  if [[ $requested == "all" ]]; then
    channels=$CHANNELS
  else
    channels=$requested
  fi

  for channel in $channels; do
    echo "channel $channel"
    if fetch_public "channels/$channel/catalog.signed.json" "$work/$channel.json"; then
      decode_envelope "$work/$channel.json" "$work/$channel.catalog" "$work/$channel.sig"
      if verify_catalog "$work/$channel.catalog" "$work/$channel.sig" >/dev/null 2>&1; then
        echo "  catalog_sequence=$(catalog_field "$work/$channel.catalog" sequence)"
        echo "  catalog_schema=$(catalog_field "$work/$channel.catalog" schemaVersion)"
        echo "  catalog_sha256=$(file_digest "$work/$channel.catalog")"
      else
        echo "  catalog_signature=FAILED"
        failures=$(( failures + 1 ))
      fi
    else
      echo "  catalog=absent"
    fi
    if fetch_public "installer/$channel/installer.json" "$work/$channel.installer.json"; then
      echo "  installer_version=$(catalog_field "$work/$channel.installer.json" version)"
      echo "  installer_sha256=$(catalog_field "$work/$channel.installer.json" sha256)"
    else
      echo "  installer=absent"
    fi
  done

  if [[ $requested == "all" ]]; then
    if [[ -f $work/stable.json && -f $work/rc.json ]] &&
      [[ $(file_digest "$work/stable.json") == "$(file_digest "$work/rc.json")" ]]; then
      echo "stable_equals_rc=yes"
    else
      echo "stable_equals_rc=no"
    fi
  fi
  (( failures == 0 )) || die "$failures channel(s) failed verification"
}

# Everything a live channel can reach, expressed as bucket prefixes. A release
# set is reachable when any channel catalog names an artifact under it; an
# installer version is reachable when any channel's installer.json points at it.
referenced_prefixes() {
  local work=$1 channel envelope catalog signature pointer
  for channel in $CHANNELS; do
    envelope="$work/$channel.env.json"
    if fetch_public "channels/$channel/catalog.signed.json" "$envelope"; then
      catalog="$work/$channel.catalog"; signature="$work/$channel.sig"
      decode_envelope "$envelope" "$catalog" "$signature"
      python3 - "$catalog" <<'PY'
import json, re, sys
catalog = json.load(open(sys.argv[1]))
seen = set()
for model in catalog["models"]:
    for role in ("engineArtifact", "metadataArtifact", "payloadArtifact", "repairManifestArtifact"):
        artifact = model.get(role)
        if not artifact:
            continue
        for record in [artifact, *artifact.get("parts", [])]:
            m = re.search(r"/(releases/[^/]+)/", record["sourceURL"])
            if m and m.group(1) not in seen:
                seen.add(m.group(1))
                print(m.group(1))
PY
    fi
    pointer="$work/$channel.channel.json"
    if fetch_public "channels/$channel/channel.json" "$pointer"; then
      # The current set too: an empty catalog names no artifact, but its own
      # release set is what the next channel promotes from.
      python3 -c '
import json, sys
pointer = json.load(open(sys.argv[1]))
for tag in (pointer.get("os_tag"), pointer.get("previous_os_tag")):
    if tag:
        print(f"releases/{tag}")
' "$pointer"
    fi
    pointer="$work/$channel.installer.json"
    if fetch_public "installer/$channel/installer.json" "$pointer"; then
      python3 - "$pointer" <<'PY'
import json, re, sys
source = json.load(open(sys.argv[1])).get("source", "")
m = re.search(r"/(installer/[0-9]+\.[0-9]+\.[0-9]+)/", source)
if m:
    print(m.group(1))
PY
    fi
  done | sort -u
}

# Stream prefixes this tool is allowed to remove: immutable release sets and
# immutable installer versions, and nothing else. Channel objects and the
# stable/rc/edge installer downloads are never candidates, and neither is
# anything outside the stream: the MX Mac feeds at the bucket root, the
# generic ISO folders, the dated Arch Linux ARM snapshots under mirror/ that
# the payload build and the acceptance guest read from.
prunable_prefixes() {
  aws s3 ls "s3://$R2_BUCKET/$STREAM_PATH/" --recursive --endpoint-url "$R2_ENDPOINT" --region auto 2>/dev/null |
    awk '{print $4}' |
    python3 -c '
import re, sys
stream = sys.argv[1] + "/"
seen = set()
for line in sys.stdin:
    key = line.strip()
    if not key.startswith(stream):
        continue
    key = key[len(stream):]
    m = re.match(r"^(releases/(?:os-)?v[0-9][^/]*|installer/[0-9]+\.[0-9]+\.[0-9]+)/", key)
    if m and m.group(1) not in seen:
        seen.add(m.group(1))
        print(m.group(1))
' "$STREAM_PATH"
}

prefix_size() {
  aws s3 ls "s3://$R2_BUCKET/$(bucket_key "$1")/" --recursive --endpoint-url "$R2_ENDPOINT" --region auto 2>/dev/null |
    awk '{b+=$3} END {printf "%d", b}'
}

prune() {
  local confirm=0
  while (( $# > 0 )); do
    case $1 in
      --confirm) confirm=1; shift ;;
      *) channels_usage ;;
    esac
  done
  command -v aws >/dev/null || die "missing command: aws"
  r2_credentials

  local work
  work=$(make_scratch)
  referenced_prefixes "$work" >"$work/referenced"
  prunable_prefixes >"$work/candidates"
  [[ -s $work/candidates ]] || die "could not list the bucket"

  local prefix total=0 size
  echo "Kept — served by a channel now, or served just before the current release:"
  while read -r prefix; do
    echo "  $prefix"
  done <"$work/referenced"
  echo "Delete:"
  : >"$work/delete"
  while read -r prefix; do
    grep -qx "$prefix" "$work/referenced" && continue
    size=$(prefix_size "$prefix")
    total=$(( total + size ))
    printf '  %6.1f GB  %s\n' "$(python3 -c "print($size/1e9)")" "$prefix"
    echo "$prefix" >>"$work/delete"
  done <"$work/candidates"
  if [[ ! -s $work/delete ]]; then
    echo "  nothing"
    return 0
  fi
  printf 'Total to delete: %.1f GB\n' "$(python3 -c "print($total/1e9)")"

  if (( ! confirm )); then
    echo "Dry run. Re-run with --confirm to delete."
    return 0
  fi
  confirm_publication "prune" "r2:$R2_BUCKET/$STREAM_PATH" "$(tr '\n' ' ' <"$work/delete")"

  # A bucket lock refuses one object at a time, so meeting it partway through
  # would leave the prune half applied. Ask the bucket before removing
  # anything.
  local lock_configuration
  if lock_configuration=$(aws s3api get-object-lock-configuration --bucket "$R2_BUCKET" \
    --endpoint-url "$R2_ENDPOINT" --region auto 2>/dev/null) &&
    [[ $lock_configuration == *ObjectLockEnabled* ]]; then
    echo "publish-channels: the sets to prune are protected by the bucket's lock rule. Pruning needs that rule to \
expire objects by age (for example 7 days) instead of holding them indefinitely; change it in \
Cloudflare R2 > $R2_BUCKET > Settings > Bucket lock, then re-run." >&2
    return 1
  fi

  while read -r prefix; do
    # Belt and braces: never remove something a channel reaches, even if the
    # channel changed between the plan and the deletion.
    if referenced_prefixes "$work" | grep -qx "$prefix"; then
      die "refusing to delete $prefix: a channel now references it"
    fi
    # The pre-flight above catches a lock rule that covers the whole bucket.
    # A narrower rule can still refuse here, so stop at the first refusal
    # rather than printing one per file.
    if ! output=$(aws s3 rm "s3://$R2_BUCKET/$(bucket_key "$prefix")/" --recursive \
      --endpoint-url "$R2_ENDPOINT" --region auto --only-show-errors 2>&1); then
      if [[ $output == *ObjectLockedByBucketPolicy* ]]; then
        echo "publish-channels: $prefix is protected by the bucket's lock rule. Pruning needs that rule to \
expire objects by age (for example 7 days) instead of holding them indefinitely; change it in \
Cloudflare R2 > $R2_BUCKET > Settings > Bucket lock, then re-run." >&2
        return 1
      fi
      echo "publish-channels: could not remove $prefix: $output" >&2
      return 1
    fi
    echo "  removed $prefix"
  done <"$work/delete"
}

channels_main() {
  (( $# > 0 )) || channels_usage
  local subcommand=$1
  shift
  case $subcommand in
    envelope)
      local catalog="" signature="" output=""
      while (( $# > 0 )); do
        case $1 in
          --catalog) catalog=${2:-}; shift 2 ;;
          --signature) signature=${2:-}; shift 2 ;;
          --output) output=${2:-}; shift 2 ;;
          *) channels_usage ;;
        esac
      done
      [[ -n $catalog && -n $signature && -n $output ]] || channels_usage
      verify_catalog "$catalog" "$signature"
      build_envelope "$catalog" "$signature" "$output"
      echo "envelope=$output"
      ;;
    empty-catalog)
      local sequence="" output=""
      while (( $# > 0 )); do
        case $1 in
          --sequence) sequence=${2:-}; shift 2 ;;
          --output) output=${2:-}; shift 2 ;;
          *) channels_usage ;;
        esac
      done
      [[ -n $output ]] || channels_usage
      write_empty_catalog "$sequence" "$output"
      ;;
    os-promote) os_promote "$@" ;;
    app-publish) app_publish "$@" ;;
    channel-status) channel_status "$@" ;;
    prune) prune "$@" ;;
    *) channels_usage ;;
  esac
}

channels_main "$@"
