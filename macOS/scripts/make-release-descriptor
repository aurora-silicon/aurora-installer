#!/bin/bash
# Write the app's release descriptor from a trust-root public key.
#
# The descriptor names every channel and rarely changes between releases: only
# a new signing key, stream or default channel needs a new one.
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  make-release-descriptor --public-key FILE --base-url URL --output FILE
                          [--default-channel stable|rc|edge] [--adhoc]

Writes release.json (schema 3) naming the stable, rc and edge catalogs
under BASE_URL (the release stream's base, for example the public base plus
the stream path) and pinning the SHA-256 fingerprint of the public key.

The helper code-signing requirement must match the build that will consume the
descriptor. The default is the production Developer ID requirement; --adhoc
writes the identifier-only requirement an ad-hoc build uses, for local
structural validation.
USAGE
  exit 64
}

die() {
  echo "make-release-descriptor: $1" >&2
  exit 1
}

public_key=""
base_url=""
output=""
default_channel="edge"
adhoc=0

while (( $# > 0 )); do
  case $1 in
    --public-key) public_key=${2:-}; shift 2 ;;
    --base-url) base_url=${2:-}; shift 2 ;;
    --output) output=${2:-}; shift 2 ;;
    --default-channel) default_channel=${2:-}; shift 2 ;;
    --adhoc) adhoc=1; shift ;;
    *) usage ;;
  esac
done

[[ -n $public_key && -n $base_url && -n $output ]] || usage
[[ -f $public_key && ! -L $public_key ]] || die "missing or unsafe public key: $public_key"
(( $(wc -c <"$public_key") == 32 )) || die "the trust root must be exactly 32 raw bytes"
[[ $base_url == https://* ]] || die "--base-url must be https: $base_url"
[[ $base_url != */ ]] || die "--base-url must not end with a slash: $base_url"
[[ $default_channel == "stable" || $default_channel == "rc" || $default_channel == "edge" ]] ||
  die "--default-channel must be stable, rc or edge"
[[ ! -e $output ]] || die "refusing to overwrite $output"

# shellcheck source=../Packaging/identity.conf
source "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../Packaging" && pwd)/identity.conf"
helper_identifier="$INSTALLER_HELPER_IDENTIFIER"
team_id="${OMARCHY_TEAM_ID:-$INSTALLER_TEAM_ID}"
fingerprint="$(python3 - "$public_key" <<'PYHASH'
import hashlib
from pathlib import Path
import sys

print("sha256:" + hashlib.sha256(Path(sys.argv[1]).read_bytes()).hexdigest())
PYHASH
)"
if (( adhoc )); then
  requirement="identifier \"$helper_identifier\""
else
  requirement="anchor apple generic and identifier \"$helper_identifier\" and certificate leaf[subject.OU] = \"$team_id\""
fi

python3 - "$output" "$fingerprint" "$base_url" "$default_channel" \
  "$helper_identifier" "$requirement" <<'PY'
import json
import sys

output, fingerprint, base_url, default_channel, helper, requirement = sys.argv[1:7]
descriptor = {
    "schema_version": 3,
    "default_channel": default_channel,
    "channels": {
        "stable": {"catalog_url": f"{base_url}/channels/stable/catalog.signed.json"},
        "rc": {"catalog_url": f"{base_url}/channels/rc/catalog.signed.json"},
        "edge": {"catalog_url": f"{base_url}/channels/edge/catalog.signed.json"},
    },
    "trust_root_fingerprint": fingerprint,
    "helper_mach_service_name": helper,
    "helper_code_signing_requirement": requirement,
}
with open(output, "x", encoding="utf-8") as stream:
    json.dump(descriptor, stream, indent=2)
    stream.write("\n")
PY

echo "release_descriptor=$output"
echo "trust_root_fingerprint=$fingerprint"
