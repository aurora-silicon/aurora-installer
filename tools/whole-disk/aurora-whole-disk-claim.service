[Unit]
Description=Add the space macOS had to the root file system (after Recovery removed macOS)
Documentation=https://github.com/aurora-silicon/aurora-distributions/blob/main/docs/whole-disk.md
# Recovery's `aura remove-macos` leaves aurora/whole-disk/removed.json on the
# EFI partition. Without it this does nothing. When
# aurora-whole-disk-move.service moved the partitions, this moves the root
# onto one partition (btrfs device add + remove, online); otherwise it adds
# the space as a second btrfs device.
ConditionPathExists=|/boot/efi/aurora/whole-disk/removed.json
ConditionPathExists=|/boot/aurora/whole-disk/removed.json
ConditionPathExists=|/efi/aurora/whole-disk/removed.json
After=local-fs.target aurora-whole-disk-move.service

[Service]
Type=oneshot
ExecStart=/usr/bin/aurora-whole-disk claim --yes
# Moving the root takes as long as copying its data; it is online and
# continues after a restart.
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
